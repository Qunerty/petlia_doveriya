# ============================================================
#  ПЕТЛЯ ДОВЕРИЯ — The Trust Loop
#  Ren'Py сценарий: диалоги, реплики, переходы между главами
# ============================================================

# --- ПЕРЕМЕННЫЕ ---
default air_supply      = 100
default group_paranoia  = 10
default trust_viktor    = 30
default trust_elena     = 30
default trust_yan       = 30

# Флаги улик
default flag_elena_broke    = False   # Елена раскололась в допросе
default flag_viktor_notebook = False  # Найден блокнот Виктора
default flag_caught_searching = False # Алекс пойман на обыске

# Флаги устранения персонажей
default yan_alive   = True
default elena_alive = True
default viktor_alive = True

# Флаг итога мини-игры 1
default minigame1_success = False

# Флаг итога мини-игры 3
default minigame3_result = 0   # 0=провал, 1=идеал, 2=прагматик(Yan)

# ============================================================
#  ПЕРСОНАЖИ
# ============================================================
define a   = Character("Алекс",   color="#a8d8ea")
define v   = Character("Виктор",  color="#e07070")
define e   = Character("Елена",   color="#c8a8d8")
define y   = Character("Ян",      color="#a8e0b0")
define sys = Character("СИСТЕМА", color="#ff4444")
define voice = Character("Голос из динамиков", color="#888888")
define narrator = Character("", window_style="say_window")


# ============================================================
#  СТИЛЬ ДЛЯ ТИТРОВ ГЛАВ
# ============================================================
style text_style:
    size 52
    color "#ffffff"
    outlines [(3, "#000000", 0, 0)]
    text_align 0.5
    xalign 0.5
    yalign 0.5

# ============================================================
#  НАЧАЛО ИГРЫ
# ============================================================
label start:

    scene black
    with fade
    $ renpy.pause(0.4)
    show text "Глава 1\nТочка невозврата" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)

    narrator "Темнота. Холод. Первое, что возвращается — это запах. Острый, химический запах озона и застоявшейся сырости. Затем приходит боль в затылке."

    scene bg_bunker_room
    with dissolve

    narrator "Зрение проясняется. Алекс видит потолок, затем резко садится. Рядом на полу и койках приходят в себя остальные."

    a "Где я?.. Руки... не слушаются. Ноги как ватные. Я... кто я?"

    y "Какого черта... Моя голова... Эй! Кто-нибудь! Где свет?!"

    v "Заткнись и не ори. Кислород тратишь."

    e "Пожалуйста, скажите, что это глупая шутка... Меня ждали дома... Мой телефон... Где мой телефон?!"

    jump chapter1_scene2


# ============================================================
#  ГЛАВА 1 — ТОЧКА НЕВОЗВРАТА
# ============================================================
label chapter1_scene2:

    narrator "Виктор подходит к Алексу и протягивает руку, оценивающе глядя сверху вниз."

    v "Живой, аналитик? Вставай. Нам нужно понять, как мы сюда попали. Ты последнее что помнишь?"

    menu:
        "Опереться на руку Виктора.":
            $ trust_viktor += 1
            $ trust_elena -= 1
            a "Спасибо. Помню только вечер... Я шёл к машине, а потом — удар. Всё."
            jump chapter1_scene3

        "Проигнорировать руку, встать самостоятельно.":
            $ group_paranoia += 1
            a "Я сам. Не трогай меня. Кто вы такие? Это вы меня сюда притащили?"
            jump chapter1_scene3

        "Подбежать к Елене, попытаться её успокоить.":
            $ trust_elena += 1
            $ trust_viktor -= 1
            a "Тише, всё хорошо. Мы выберемся. Главное — без паники."
            jump chapter1_scene3


label chapter1_scene3:

    scene bg_bunker_room
    with flash

    play sound "alarm.ogg"

    narrator "Раздаётся резкий, бьющий по ушам звуковой сигнал. Экран на стене вспыхивает ядовито-зелёным. На нём появляется силуэт без лица."

    voice "Приветствую вас, подопытные. Не пытайтесь вспомнить, как вы здесь оказались — это побочный эффект транквилизатора. Он пройдёт через пару часов. Перейдём к главному."

    narrator "На экране загорается таймер: 47:59:59, и две шкалы — «Ресурс воздуха: 100%» и «Популяция: 4»."

    voice "Вы находитесь в автономном бункере. Воздуха и фильтров для четверых хватит ровно на 48 часов. Если вас останется двое — система снизит потребление, и кислорода хватит на 30 дней, пока замки не откроются автоматически."

    voice "Но есть нюанс. Один из вас — мой сообщник, «Кукловод». Он знает коды доступа, но не скажет их вам, потому что его цель — довести эксперимент до конца. Убейте его, найдите коды, или просто... сократите популяцию. Время пошло."

    narrator "Экран гаснет. Таймер начинает обратный отсчёт."

    jump chapter2_start


# ============================================================
#  ГЛАВА 2 — ПЕРВЫЙ КРИЗИС И МИНИ-ИГРА №1
# ============================================================
label chapter2_start:

    scene bg_bunker_room
    with fade

    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Глава 2\nПервый кризис" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_room
    with dissolve
    narrator "Проходит два часа. Атмосфера накаляется. Ян мечется по комнате. Виктор пытается вскрыть распределительный щиток."

    y "Это он! Это Виктор! Посмотрите на него — он же наемник какой-то! Он нас всех тут перережет, чтобы воздуха больше было!"

    v "Если ты не закроешь рот, щегол, я начну уменьшать популяцию прямо сейчас. Начнём с тебя."

    e "Прекратите! Вы не видите? Экрану нужно, чтобы мы перебивали друг друга! Алекс, сделай что-нибудь, ты же молчишь и думаешь всё это время!"

    scene bg_bunker_room_red
    with flash

    play sound "alarm_critical.ogg"

    sys "ВНИМАНИЕ! БЛОКИРОВКА ВОЗДУШНОГО КЛАПАНА СЕКТОРА А. ОСТАТОК КИСЛОРОДА: 15 МИНУТ"

    v "Щиток заклинило электронным замком. Нужен код или обход цепи."

    y "Я... я могу взломать через сервисный порт под экраном, но там зашифрованный протокол! Мне нужны инструменты и чтобы мне не мешали!"

    narrator "--- МИНИ-ИГРА №1: «ВЗЛОМ ПРОТОКОЛА» (Логика) ---"
    narrator "Перед игроком открывается панель терминала. Задача: за 90 секунд расставить логические элементы, чтобы ток прошёл от левого края к правому."

    # Здесь вызов мини-игры; результат пишется в minigame1_success
    # call screen minigame_hack
    # В прототипе — меню-заглушка:
    menu:
        "Успешно взломать терминал.":
            $ minigame1_success = True
            jump chapter2_success

        "Не справиться со взломом.":
            $ minigame1_success = False
            jump chapter2_fail


label chapter2_success:

    narrator "Раздаётся свист — вентиляция запускается. Воздух снова идёт."

    $ group_paranoia = max(0, group_paranoia - 20)

    v "Убираю заточку. Ладно... Молодцы."

    y "Алекс... Спасибо. Извини за панику."

    jump chapter3_start


label chapter2_fail:

    narrator "Время вышло. Воздуха становится мало. Виктор в панике выбивает щиток голыми руками, ломая руку Яну, но перерезая провод напрямую. Вентиляция запускается аварийно."

    $ air_supply = min(100, max(0, air_supply - 15))
    $ group_paranoia = min(100, group_paranoia + 40)
    $ trust_yan -= 10

    v "Терпи, щегол. Зато живы."

    y "Ты сломал мне руку, псих!!!"

    e "Прекратите, ради бога..."

    narrator "Все подозревают Яна или Алекса в саботаже."

    jump chapter3_start


# ============================================================
#  ГЛАВА 3 — РАЗДЕЛЕНИЕ ТЕРРИТОРИИ И ПЕРВЫЕ УЛИКИ
# ============================================================
label chapter3_start:

    scene bg_bunker_hub
    with dissolve

    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Глава 3\nРазделение территории" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_hub
    with dissolve
    narrator "Группа стоит в центральном шлюзе. Воздух из вентиляции идёт со слабым свистом."

    if not minigame1_success:
        v "Итак, мы выяснили, что сидеть в одной комнате — верная смерть. Предлагаю разделиться. Я беру под охрану жилой блок. Там есть железные шкафы — проверим, что в них."
    else:
        v "Итак. Предлагаю разделиться и обыскать бункер. Я беру жилой блок под охрану."

    y "Ага, конечно, чтобы ты там заперся с оружием, если найдёшь его? Нет уж. Я иду в технический отсек. Там терминалы управления. Если этот урод на экране не соврал — я смогу найти лазейку в коде и открыть шлюз раньше, чем через 48 часов."

    e "А я пойду в медицинский блок. Там должны быть успокоительные... и вода. Я распределю всё поровну, честно. Алекс, ты пойдёшь со мной? Мне страшно оставаться одной."

    menu:
        "Пойти с Яном в технический отсек.":
            $ trust_yan += 15
            $ group_paranoia = min(100, group_paranoia + 5)
            $ trust_viktor -= 5
            jump chapter3_yan_branch

        "Пойти с Еленой в медблок.":
            $ trust_elena += 15
            $ trust_viktor -= 5
            jump chapter3_elena_branch

        "Остаться с Виктором в жилом блоке.":
            $ trust_viktor += 15
            $ trust_yan -= 10
            jump chapter3_viktor_branch


# --- Ветка Яна ---
label chapter3_yan_branch:

    scene bg_bunker_tech
    with dissolve

    narrator "Технический отсек. Гул серверов, мигающие индикаторы, запах перегретого железа."

    y "Вот, смотри. Здесь должен быть внешний канал телеметрии. Если его открыть — можно послать сигнал наружу или вытащить план бункера из архива."

    a "Ты говоришь уверенно. Ты уже бывал в таких системах?"

    y "Ну... в похожих. Слушай, не смотри на меня так. Я программист, это моя работа."

    narrator "На руках Яна видны следы химических ожогов. Он нервно отводит взгляд."

    a "Что с руками?"

    y "Рабочая травма. Забудь. Помогай лучше."

    jump chapter4_start


# --- Ветка Елены ---
label chapter3_elena_branch:

    scene bg_bunker_medical
    with dissolve

    narrator "Медицинский блок. Стерильно-белые стены. Операционный стол. Шкафы с лекарствами закрыты на кодовые замки."

    e "Спасибо, что пошёл со мной. Виктор пугает меня до усрачки. Ты видел его руки? У него татуировка подразделения, которое расформировали за военные преступления..."

    a "Откуда ты это знаешь?"

    e "Я работаю журналистом. Точнее, работала, пока не очнулась здесь. Специализируюсь на расследованиях."

    e "И знаешь что? Мне кажется, этот бункер принадлежит корпорации, о которой я писала статью в прошлом месяце. Нам нужно вскрыть эти замки, чтобы достать воду."

    narrator "Елена подходит к шкафу. Алекс замечает на одной из полок разбитую ампулу с маркировкой «B-7». Точно такой же запах озона стоял в комнате, когда они проснулись."

    a "(мысленно) Она сказала, что не знает, как мы тут оказались. Но разбитая ампула свежая. Кто-то воспользовался ей совсем недавно..."

    narrator "Елена замечает, что Алекс разглядывает ампулу. Её лицо мгновенно меняется. Доброжелательность исчезает."

    e "Ты ведь что-то нашёл, да, Алекс? Ты смотришь на меня так, будто я... чудовище. Ты думаешь, это я нас сюда заперла? Хочешь обыскать мои карманы? Попробуй. Но учти: если ты ошибёшься, я закрою этот блок, и воду вы больше не увидите."

    narrator "Дверь медицинского блока с тихим щелчком блокируется снаружи. Начинается психологическое противостояние."

    jump minigame2_start


# Мини-игра 2 доступна только из ветки Елены
label minigame2_start:

    narrator "--- МИНИ-ИГРА №2: «ДОПРОС ЗА ЗАКРЫТОЙ ДВЕРЬЮ» (Манипуляция) ---"
    narrator "У Алекса 4 хода, чтобы расколоть Елену, не подняв её тревогу до максимума."

    # Ход 1
    narrator "ХОД 1:"
    menu:
        "«Елена, успокойся. Я просто спросил про ампулу. Почему ты так нервничаешь?»":
            narrator "(Пульс: 85 bpm. Тревога без изменений.)"
            jump minigame2_move2_safe

        "«Хватит строить из себя жертву. Ты журналист, ты знала про этот бункер. Это твоя работа?!»":
            narrator "(Пульс: 110 bpm. Тревога +25%.)"
            jump minigame2_move2_aggressive

        "«Я верю тебе. Но если мы не будем честны друг с другом, Виктор нас убьёт. Расскажи про ампулу.»":
            narrator "(Эмпатия. Пульс: 75 bpm. Тревога -10%.)"
            jump minigame2_move2_empathy


label minigame2_move2_safe:
    # Ход 2 — нейтральный путь
    narrator "ХОД 2:"
    a "Эта ампула... Из-за её содержимого мы спали. Запах озона. Ты проснулась раньше нас?"

    e "Я... я просто нашла её на полу, когда зашла. Хотела спрятать, чтобы Ян не устроил истерику!"

    narrator "(Пульс: 120 bpm — она врёт.)"

    narrator "ХОД 3:"
    a "Пульс выдаёт тебя, Елена. Кто тебе заплатил?"

    e "Никто! Ты с ума сошёл?!"

    narrator "ХОД 4:"
    menu:
        "«Я не твой враг. Но я знаю, что ты лжёшь. Скажи правду — и я никому не расскажу.»":
            jump minigame2_success
        "«Говори сейчас, или я расскажу всё Виктору.»":
            jump minigame2_fail


label minigame2_move2_aggressive:
    narrator "ХОД 2:"
    e "Ты... ты с ума сошёл! Я здесь жертва, как и ты!"

    narrator "(Тревога критически высокая.)"

    narrator "ХОД 3:"
    menu:
        "Попытаться успокоить её.":
            a "Извини. Я не хотел тебя обидеть. Просто скажи про ампулу."
            jump minigame2_move4_last_chance
        "Давить дальше.":
            jump minigame2_fail


label minigame2_move2_empathy:
    narrator "ХОД 2:"
    a "Эта ампула... Из-за её содержимого мы спали. Ты знаешь, что в ней было?"

    e "Я... (долгая пауза) Ладно. Это снотворное. Я видела такие во время одного расследования."

    narrator "ХОД 3:"
    a "Где ты видела их раньше?"

    e "В лаборатории одной корпорации. Я писала о ней статью. Алекс, я не знала, что нас запрут здесь умирать, клянусь."

    narrator "ХОД 4:"
    a "Кто попросил тебя принести её?"

    jump minigame2_success


label minigame2_move4_last_chance:
    narrator "ХОД 4:"
    a "Елена, последний шанс. Расскажи про ампулу."
    menu:
        "Продолжать мягко давить.":
            jump minigame2_success
        "Сорваться на крик.":
            jump minigame2_fail


label minigame2_success:

    e "Ладно! Ладно! Это я разбила её! Но не потому, что я Кукловод! Мне заплатили за то, чтобы я пронесла её на встречу с вами. Я должна была просто усыпить вас для перевозки — я не знала, что нас запрут здесь умирать!"

    a "Кто заплатил?"

    e "Я не знаю имён. Только почта и криптокошелёк. Алекс... пожалуйста, не говори остальным. Если Виктор узнает — он меня убьёт."

    $ trust_elena = 60
    $ flag_elena_broke = True

    narrator "Дверь медблока открывается. Получена ключевая улика: «Елена — наёмный перевозчик, но не организатор»."

    jump chapter4_start


label minigame2_fail:

    narrator "Тревога Елены достигает 100%. Она впадает в истерику и бьёт медицинским лотком по терминалу двери."

    narrator "Дверь открывается от замыкания, но Елена выбегает в коридор с криками, что Алекс пытался её задушить."

    $ trust_elena = 0
    $ group_paranoia = min(100, group_paranoia + 30)

    e "Он напал на меня! Алекс хотел меня задушить!!"

    v "Что?! Аналитик, объяснись."

    y "Я так и знал! Он псих!"

    narrator "Доступ к медикаментам заблокирован аварийной системой."

    jump chapter4_start


# --- Ветка Виктора ---
label chapter3_viktor_branch:

    scene bg_bunker_living
    with dissolve

    narrator "Жилой блок. Железные шкафы вдоль стен. Виктор вскрывает один из них монтировкой."

    v "Правильный выбор. Сейчас важно понять, что тут есть из полезного."

    a "Ты слишком хорошо знаешь, что искать."

    v "Армейская подготовка. Привычка."

    a "За какое подразделение служил?"

    narrator "Виктор на секунду застывает, затем продолжает вскрывать шкаф."

    v "За то, которое тебе лучше не знать. Смотри лучше, нет ли тут чего-то полезного."

    narrator "В дальнем углу Алекс замечает сейф с кодовым замком. Виктор делает вид, что не видит его."

    jump chapter4_start


# ============================================================
#  ГЛАВА 4 — НОЧЬ ПАРАНОЙИ И ДИКТАТУРА СИЛЫ
# ============================================================
label chapter4_start:

    scene bg_bunker_hub_night
    with dissolve

    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Глава 4\nНочь паранойи" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_hub_night
    with dissolve
    narrator "Основное освещение отключается — синяя неоновая подсветка по плинтусам. Таймер: 23:14:02."

    v "Хватит играть по правилам этого ублюдка из телевизора. Часики тикают, а вы только и делаете, что перешёптываетесь по углам. Ян что-то замышляет у своих терминалов, Елена подсыпает дрянь в воду. С этого момента я ввожу здесь военное положение."

    y "Ты спятил?! Ты хочешь нас просто запереть и дождаться, пока мы задохнёмся?!"

    v "Я хочу выжить. А для этого припасы и контроль над воздухом должны быть в одних руках. В моих. Алекс, ты парень с мозгами. Либо ты сейчас помогаешь мне усмирить этих двоих и мы вместе распределяем ресурсы — либо ты остаёшься с ними за бортом. Выбирай быстро."

    menu:
        "Принять сторону Виктора (Путь силы).":
            $ trust_viktor += 25
            $ trust_yan -= 30
            $ trust_elena -= 20
            $ group_paranoia = min(100, group_paranoia + 30)
            a "Ладно, Виктор. Но мы берём под контроль только воду. Никакого насилия."
            v "Договорились. Для начала."
            narrator "Ян в ярости убегает вглубь вентиляционных шахт."
            jump chapter4_sabotage

        "Встать на защиту Яна и Елены (Путь оппозиции).":
            $ trust_viktor -= 30
            $ trust_yan += 15
            $ trust_elena += 15
            a "Нет. Мы не животные. Никакого военного положения."
            v "Ты делаешь ошибку, аналитик."
            narrator "Виктор замыкается в жилом блоке, блокируя доступ к кроватям и части сухпайков."
            jump chapter4_sabotage

        "Попытаться потянуть время и перевести тему.":
            $ group_paranoia = min(100, group_paranoia + 10)
            a "Подождите. Нам нужно сначала проверить запасы воздуха и..."
            v "У меня кончилось терпение, Алекс."
            narrator "Никто не доверяет Алексу."
            jump chapter4_sabotage


label chapter4_sabotage:

    scene bg_bunker_hub_red
    with flash

    play sound "alarm_wail.ogg"

    sys "КРИТИЧЕСКИЙ СБОЙ: КЛАПАНЫ ВЕНТИЛЯЦИИ ПЕРЕКРЫТЫ ВРУЧНУЮ ИЗ ИНЖЕНЕРНОГО ОТСЕКА. СКОРОСТЬ ПАДЕНИЯ КИСЛОРОДА УВЕЛИЧЕНА В 5 РАЗ"

    v "Ах ты мелкий ублюдок! Всё-таки решил нас придушить?!"

    y "Это не я! Я был здесь, с вами! Мой терминал взломали удалённо! Кто-то залез в систему жизнеобеспечения из другого сектора!"

    e "Воздух... становится слишком тяжело дышать... Сделайте что-нибудь..."

    narrator "--- МИНИ-ИГРА №3: «РАСПРЕДЕЛЕНИЕ ВОЗДУХА» (Менеджмент выживания) ---"
    narrator "На схеме — четыре сектора. Общий уровень кислорода: 40 единиц. Нужно довести каждый сектор минимум до 10 единиц за 5 ходов."
    narrator "Жилой блок (Виктор): 25 ед. Технический (Ян): 5 ед. Медблок (Елена): 5 ед. Центр (Алекс): 5 ед."

    # Заглушка выбора исхода
    menu:
        "Идеально сбалансировать все секторы (10/10/10/10).":
            $ minigame3_result = 1
            jump minigame3_ideal

        "Спасти себя и одного человека, пожертвовав остальными (например, обделить Яна).":
            $ minigame3_result = 2
            jump minigame3_pragmatic

        "Запутаться в вентилях — полный провал.":
            $ minigame3_result = 0
            jump minigame3_total_fail


label minigame3_ideal:

    narrator "Все показатели выровнены. Вентиляция гудит ровно."

    $ group_paranoia = max(0, group_paranoia - 15)

    v "Ян... Выходит, тебя правда взломали удалённо."

    y "Я же говорил."

    narrator "Группа получает временную передышку."

    jump chapter5_start


label minigame3_pragmatic:

    narrator "Ян падает в обморок от гипоксии. Он выживет, но получит тяжёлое когнитивное расстройство."

    $ trust_yan = 0

    v "Ты сделал правильный выбор, аналитик. Математика есть математика."

    e "Алекс... Ты понимаешь, что только что сделал?"

    a "(мысленно) Понимаю."

    jump chapter5_start


label minigame3_total_fail:

    narrator "Время истекло. Система заблокировала клапаны в случайном положении."

    $ air_supply = max(0, air_supply - 30)
    $ group_paranoia = min(100, group_paranoia + 20)

    sys "АВАРИЙНАЯ БЛОКИРОВКА КЛАПАНОВ. РЕЖИМ ЖИЗНЕОБЕСПЕЧЕНИЯ: КРИТИЧЕСКИЙ."

    v "Ты провалил всё. Я сам разберусь с этим."

    narrator "Все персонажи получают дебафф «Тяжёлое удушье»."

    jump chapter5_start


# ============================================================
#  ГЛАВА 5 — ОХОТА В ТЕМНОТЕ
# ============================================================
label chapter5_start:

    scene bg_bunker_dark
    with dissolve

    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Глава 5\nОхота в темноте" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_dark
    with dissolve
    narrator "Бункер полностью обесточен. Единственный источник света — ручные фонарики. Таймер: 06:00:00."

    a "(мысленно) Чтобы раскрыть личность Кукловода и найти код от главного выхода, нужно действовать грязно. У Виктора в армейском жетоне или в запертом кейсе должен быть ключ. Он слишком уверенно себя чувствует в этом бункере. Словно знает планировку..."

    narrator "--- МИНИ-ИГРА №4: «ОБЫСК В ТЕМНОТЕ» (Стелс и внимательность) ---"
    narrator "Затемнённая комната Виктора. Игрок управляет кругом света от фонарика. Нужно за 60 секунд найти три улики, пока шкала «Риск обнаружения» не достигла 100%."
    narrator "Цели: армейский блокнот (под матрасом), электронный брелок (в кармане куртки), следы крови у вентиляционной решётки."

    menu:
        "Найти все три улики и уйти незамеченным.":
            $ flag_viktor_notebook = True
            $ flag_caught_searching = False
            jump chapter5_search_success

        "Быть пойманным с поличным.":
            $ flag_viktor_notebook = False
            $ flag_caught_searching = True
            jump chapter5_search_fail


label chapter5_search_success:

    narrator "В блокноте Виктора обнаруживается чертёж этого самого бункера, датированный трёхлетней давностью."
    narrator "На полях — приписка: «Мой сын заперт где-то здесь»."

    a "(мысленно) Виктор — не Кукловод. Он ищет своего ребёнка, которого похитила та же организация."

    narrator "Электронный брелок — это глушилка сигналов. Получена финальная разгадка."

    jump chapter6_start


label chapter5_search_fail:

    narrator "Шкала риска достигла 100%. В комнату резко заходит Виктор."

    v "Аналитик. Что ты делаешь в моей комнате."

    narrator "Это не вопрос."

    a "Я... искал запасные батарейки."

    v "Не ври мне."

    narrator "Виктор бьёт Алекса. trust_viktor падает до нуля. Виктор забирает все собранные улики."

    $ trust_viktor = 0

    v "Ещё раз войдёшь сюда — сломаю что-нибудь важнее руки."

    jump chapter6_start


# ============================================================
#  ГЛАВА 6 — ЧАС ИСТИНЫ (ФИНАЛ)
# ============================================================
label chapter6_start:

    scene bg_bunker_finale
    with dissolve

    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Глава 6\nЧас истины" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_finale
    with dissolve
    narrator "Центральный шлюз. Главная гермодверь подсвечена красным. Таймер: 00:05:00..."

    if viktor_alive:
        v "Ну что, аналитик. Пришли к концу. Воздуха почти нет. Если мы сейчас не решим, кто из нас тварь — мы все сгнием в этой бетонной коробке. Что ты раскопал? Говори сейчас, или я сам решу, кто здесь лишний."

    if elena_alive:
        e "Алекс... Пожалуйста... Ты ведь знаешь, что это не я... Мы же доверяли друг другу в медблоке..."

    if yan_alive:
        y "Код... коды заблокированы... Система требует подтверждения от администратора... Администратор среди нас! Алекс, скажи им!"

    narrator "Экран над дверью вспыхивает: «ВРЕМЯ ЭКСПЕРИМЕНТА ИСТЕКЛО. ВЫБЕРИТЕ КУКЛОВОДА ИЛИ ВЫПОЛНИТЕ УСЛОВИЕ ПОПУЛЯЦИИ»."

    # Проверяем условия концовок
    jump endings_check


label endings_check:

    # Концовка 1 — Идеальная победа
    if yan_alive and elena_alive and viktor_alive and flag_elena_broke and flag_viktor_notebook:
        jump ending1

    # Концовка 4 — Самопожертвование
    elif yan_alive and elena_alive and viktor_alive and trust_yan > 50 and trust_elena > 50 and trust_viktor > 50 and air_supply < 10:
        jump ending4

    # Концовка 5 — Гамбит (Елена предаёт)
    elif trust_elena > 70 and not viktor_alive and not flag_viktor_notebook:
        jump ending5

    # Концовка 2 — Цена выживания
    elif trust_viktor > 60 and (not yan_alive or not elena_alive):
        jump ending2

    # Концовка 3 — Одиночество
    elif group_paranoia > 80 and not yan_alive and not elena_alive and not viktor_alive:
        jump ending3

    # Концовка 6 — Взаимное уничтожение
    elif air_supply <= 0 or group_paranoia >= 100:
        jump ending6

    # Резервный переход к концовке 6
    else:
        jump ending6


# ============================================================
#  КОНЦОВКИ
# ============================================================

label ending1:
    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Концовка 1\n«Чистый холод»" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_outside
    with dissolve

    a "Никто из нас не Кукловод. Настоящий Кукловод — это Ян. Точнее, его кураторы. Ян, твой планшет не заблокирован. Тот брелок, что я нашёл у Виктора — это глушилка, которую Виктор принёс, чтобы спасти своего сына. Ты использовал её частоту, чтобы сымитировать сбой вентиляции."

    narrator "Яна бьёт дрожь. Он понимает, что раскрыт."

    y "Они... они обещали отпустить мою сестру, если я доведу вас до безумия... Извините..."

    a "Приложи руку к сканеру и введи мастер-код."

    narrator "Тяжёлые гидравлические затворы шлюза со скрежетом поддаются. В бункер врывается поток холодного, свежего ночного воздуха."

    narrator "Группа, поддерживая друг друга, выходит наружу. Они выжили и сохранили человечность. На горизонте видны огни города. Эксперимент провален."

    return


label ending2:
    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Концовка 2\n«Цена выживания»" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_outside_grey
    with dissolve

    narrator "На сканере горят только две зелёные лампы. Алекс и Виктор стоят у шлюза. Тела остальных остались в тёмных коридорах бункера."

    narrator "Таймер доходит до нуля. Раздаётся громкий щелчок. Дверь медленно отходит в сторону."

    v "Мы сделали то, что должны были, Алекс. Не смотри назад. Нас ждёт жизнь."

    narrator "Они выходят на ослепительный солнечный свет. Но внутри у Алекса — лишь звенящая пустота. До конца своих дней он будет просыпаться от кошмаров, слыша хрип тех, кого они оставили в темноте."

    return


label ending3:
    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Концовка 3\n«Одиночество в темноте»" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_finale
    with dissolve

    narrator "Алекс стоит один посреди залитого кровью и тишиной шлюза. Он прикладывает ладонь к сканеру. Дверь открывается."

    narrator "На экране появляется лицо истинного организатора."

    voice "Потрясающе, Алекс. Ты уничтожил всех, даже не будучи моим сообщником. Паранойя — лучший убийца. Ты свободен. Но сможешь ли ты жить с тем, что ты сделал?"

    narrator "Алекс падает на колени перед закрывающимся выходом. Он победил в игре, но потерял рассудок."

    return


label ending4:
    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Концовка 4\n«Доверие до гроба»" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_tech_dark
    with dissolve

    narrator "Воздуха осталось на пару минут. Алекс понимает: система не откроет дверь, пока людей четверо."

    a "Виктор, уведи Елену и Яна к шлюзу. Я закрою себя в техническом отсеке и перекрою туда подачу. Система зафиксирует снижение популяции и выпустит вас."

    e "Нет, Алекс! Мы выберемся вместе!"

    a "Идите."

    narrator "Алекс улыбается, заходит в отсек и нажимает кнопку блокировки."

    sys "Популяция: 3. Доступ разрешён."

    narrator "Двери открываются для троих. Алекс закрывает глаза, делая последний, чистый вдох. Он спас их."

    return


label ending5:
    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Концовка 5\n«Гамбит Кукловода»" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_finale
    with dissolve

    narrator "Виктор лежит без сознания. Алекс поворачивается к Елене, ожидая, что они вместе приложат руки к сканеру."

    narrator "Елена подходит ближе, мягко улыбается... и резко бьёт Алекса шокером, спрятанным в рукаве. Алекс падает, парализованный."

    e "Ты был отличным инструментом, Алекс. Умным, но слишком доверчивым. Спасибо, что помог убрать Виктора. Организаторы будут довольны моим отчётом."

    narrator "Она прикладывает руку, вводит код и выходит, оставляя Алекса умирать на полу рядом с тикающим таймером."

    return


label ending6:
    scene black
    with dissolve
    $ renpy.pause(0.4)
    show text "Концовка 6\n«Взаимное уничтожение»" with dissolve
    $ renpy.pause(2.0)
    hide text with dissolve
    $ renpy.pause(0.3)
    scene bg_bunker_finale
    with dissolve

    narrator "Слова кончились. Вспыхивает слепая ярость."

    if viktor_alive:
        v "Хватит!!!"

    if yan_alive:
        y "Отойди от меня!!"

    if elena_alive:
        e "Прекратите, прекратите, ПРЕКРАТИТЕ!"

    narrator "В этот момент багровый свет гаснет навсегда. Вентиляция затихает."

    narrator "Последнее, что фиксирует игра — четыре неподвижных силуэта на полу Центрального шлюза под безразличным, погасшим экраном. Коробка закрылась навсегда."

    return
